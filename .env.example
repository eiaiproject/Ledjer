# ──────────────────────────────────────────────────────────────
# Ledjer — Root environment template
# ──────────────────────────────────────────────────────────────
# Copy to .env at repo root for local tooling (optional).
# Frontend env lives in apps/web/.env.local — see apps/web/.env.example.
#
# Optional: VITE_API_BASE_URL, VITE_SENTRY_DSN (frontend)
# Worker/server: APP_ORIGIN plus optional EMAIL/Google/Sentry secrets
#
# Placeholders use "your-*" — replace before deploy.
# Never commit real secrets.

# Worker runtime
APP_ORIGIN=https://ledjer.id
EMAIL_API_KEY=your-email-provider-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SENTRY_DSN=

# Sentry (optional — frontend error tracking)
# Frontend: VITE_SENTRY_DSN (browser-safe, set in apps/web/.env.local)
# CI/source-map upload (server-side only, never exposed to browser):
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
