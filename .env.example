# ──────────────────────────────────────────────────────────────
# Ledjer — Root environment template
# ──────────────────────────────────────────────────────────────
# Copy to .env at repo root for local tooling (optional).
# Frontend env lives in apps/web/.env.local — see apps/web/.env.example.
#
# Required: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
# Optional: VITE_SENTRY_DSN (error tracking)
#
# Placeholders use "your-*" — replace before deploy.
# Never commit real secrets.

# Supabase (read by scripts, CI, admin tooling)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# ⚠️  NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend hosting or .env.local.
#     Use only in: Supabase SQL console, CI admin scripts, Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry (optional — frontend error tracking)
# Frontend: VITE_SENTRY_DSN (browser-safe, set in apps/web/.env.local)
# CI/source-map upload (server-side only, never exposed to browser):
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
