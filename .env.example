[TEMPLATE]
# ──────────────────────────────────────────────────────────────
# Ledjer — Root environment template
# ──────────────────────────────────────────────────────────────
# Copy to .env at repo root for local tooling (optional).
# Frontend env lives in apps/web/.env.local — see apps/web/.env.example.
#
# Placeholders use "your-*" — replace before deploy.
# Never commit real secrets.

# ── Worker runtime (injected via wrangler.jsonc vars + Cloudflare secrets) ──
# These are set as Cloudflare Worker secrets/env via wrangler or dashboard.
APP_ENV=production
APP_ORIGIN=https://ledjer.id
COOKIE_DOMAIN=.ledjer.id
SESSION_SECRET=your-session-secret-min-32-chars
PASSWORD_PEPPER=your-pepper-string

# Sentry (optional — error tracking)
# Worker-side: SENTRY_DSN (server-side, never exposed to browser)
SENTRY_DSN=

# ── Sentry source-map upload (CI only, never exposed to browser) ──
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Frontend (Vite) — set in apps/web/.env.local ──
# VITE_API_BASE_URL=        # empty = same-origin
# VITE_SENTRY_DSN=          # browser-safe Sentry DSN
# VITE_APP_VERSION=         # optional version string