# ──────────────────────────────────────────────────────────────
# Ledjer Admin — Frontend environment (Vite)
# ──────────────────────────────────────────────────────────────
# Copy to apps/admin/.env.local and fill in real values.
#
# All VITE_* variables are embedded in the browser bundle.
# Never place secrets here.

# API base URL. Leave empty when frontend and Worker API are same-origin.
VITE_API_BASE_URL=
