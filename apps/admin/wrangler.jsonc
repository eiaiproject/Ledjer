{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ledjer-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Admin dashboard reads the same production D1 database (all tenants) and
  // the same R2 backup bucket as the main app. Migrations stay in the main
  // worker's migrations_dir (single source of truth for the D1 schema).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledjer-production",
      "database_id": "37eff57a-d152-4235-8344-9379c7ad4cf2",
      "preview_database_id": "304c2ea3-7368-420e-92fa-64a06411f3bf"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "ledjer-backups",
      "preview_bucket_name": "ledjer-backups-preview"
    }
  ],
  // Custom domain admin.ledjer.id is managed via Cloudflare Dashboard
  // (Workers > ledjer-admin > Settings > Domains & Routes), matching the
  // production pattern in apps/web and apps/docs. Declaring `routes` here
  // makes CI call the /zones/{zone}/workers/routes API, which the deploy
  // token (CF_API_TOKEN) lacks permission for.
  // Service binding to the main worker. Worker→Worker via public *.workers.dev
  // hostname fails with CF error 1042 ("could not resolve host") from the
  // internal resolver; a service binding dispatches the call directly and is
  // the supported way for the admin dashboard to health-check the main app.
  "services": [
    {
      "binding": "MAIN_APP",
      "service": "ledjer"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_ORIGIN": "https://admin.ledjer.id"
  },

  "env": {
    "staging": {
      "name": "ledjer-admin-staging",
      "vars": {
        "APP_ENV": "staging",
        "APP_ORIGIN": "https://ledjer-admin-staging.eiai.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ledjer-staging",
          "database_id": "6bb8c1af-cf43-4d8e-b28c-ee8b9ce13a1d"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "ledjer-backups-staging"
        }
      ],
      "services": [
        {
          "binding": "MAIN_APP",
          "service": "ledjer-staging"
        }
      ]
    }
  }
}
