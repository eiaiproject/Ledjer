# Security headers for docs.ledjer.id (security review F-06).
#
# Workers Static Assets serves files directly from the edge cache without
# invoking the worker script, so header injection in worker/index.js never
# runs for asset requests. `_headers` is the supported mechanism: Workers
# Assets applies these rules at serving time (same pattern as apps/web and
# apps/admin). Keep this file in sync with their _headers.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # script-src keeps 'unsafe-inline': VitePress ships three bootstrap inline
  # scripts (dark-mode check, macOS class, __VP_HASH_MAP__). The hash map
  # embeds per-build asset names, so sha256 pins would silently break on
  # every content change. The site is fully static with no untrusted input,
  # which bounds the inline-script risk.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
