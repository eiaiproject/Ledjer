{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledjer-docs",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-12",
  // Custom domain is managed via Cloudflare Dashboard
  // (Workers > ledjer-docs > Settings > Domains & Routes), matching the
  // production pattern in apps/web/wrangler.jsonc. Declaring `routes` here
  // makes CI call the /zones/{zone}/workers/routes API, which the deploy
  // token (CF_API_TOKEN) lacks permission for — the upload succeeds but the
  // action fails with Authentication error [code: 10000].
  "assets": {
    "directory": "docs/.vitepress/dist",
    "binding": "ASSETS",
    // Static docs site: missing pages return the built 404.html (not SPA
    // fallback) so broken links are surfaced instead of silently masked.
    "not_found_handling": "404-page",
    // cleanUrls-friendly: /panduan/transaksi serves transaksi/index.html.
    "html_handling": "auto-trailing-slash"
  }
}
