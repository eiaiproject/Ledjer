# ──────────────────────────────────────────────────────────────
# Ledjer — Frontend environment (Vite)
# ──────────────────────────────────────────────────────────────
# Copy to apps/web/.env.local and fill in real values.
#
# All VITE_* variables are embedded in the browser bundle.
# Never place secrets here — only public keys and safe URLs.

# API base URL. Leave empty when frontend and Worker API are same-origin.
VITE_API_BASE_URL=

# Sentry DSN (public/browser-safe) — if omitted, Sentry is disabled
VITE_SENTRY_DSN=

# App version (optional, shown in footer/debug)
VITE_APP_VERSION=
