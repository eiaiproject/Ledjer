# ──────────────────────────────────────────────────────────────
# Ledjer — Frontend environment (Vite)
# ──────────────────────────────────────────────────────────────
# Copy to apps/web/.env.local and fill in real values.
#
# All VITE_* variables are embedded in the browser bundle.
# Never place secrets here — only public keys and safe URLs.
#
# Required for local dev, staging, and production.

# Supabase project URL (from Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key — safe for browser exposure
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Optional ────────────────────────────────────────────────

# Sentry DSN — if omitted, Sentry is disabled (no errors sent)
VITE_SENTRY_DSN=

# App base URL — used in auth redirect construction (leave empty to use window.location.origin)
# Only set if deploying behind a proxy or on a non-standard path.
# VITE_APP_URL=https://ledjer.id

# ── Private Beta / Staging ──────────────────────────────────
# For staging, duplicate this file as .env.staging and point
# VITE_SUPABASE_URL to the staging Supabase project.
# For production/private beta, set these in your hosting platform
# (Vercel / Cloudflare Pages / Netlify dashboard env vars).
