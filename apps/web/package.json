{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Ledjer web frontend and Cloudflare Worker API.",
  "keywords": [
    "ledjer",
    "accounting",
    "bookkeeping",
    "umkm",
    "react",
    "cloudflare"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --pretty false && vite build && bash scripts/postbuild-csp.sh",
    "cf:deploy": "wrangler deploy --config wrangler.jsonc",
    "cf:dev": "vite dev",
    "db:migrations:apply": "wrangler d1 migrations apply DB",
    "db:migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:apply:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrations:list": "wrangler d1 migrations list DB",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test e2e/smoke.spec.ts e2e/auth.spec.ts e2e/security-public.spec.ts e2e/static-routes.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "analyze": "ANALYZE=true vite build",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/cloudflare": "^10.76.0",
    "@sentry/react": "^10.76.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "reicon-react": "^1.2.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
