{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --pretty false && vite build && bash scripts/postbuild-csp.sh",
    "cf:deploy": "wrangler deploy",
    "cf:dev": "vite dev",
    "db:migrations:apply": "wrangler d1 migrations apply DB",
    "db:migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:apply:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrations:list": "wrangler d1 migrations list DB",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test e2e/smoke.spec.ts e2e/auth.spec.ts e2e/security-public.spec.ts e2e/accessibility.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:visual": "E2E_VISUAL=1 playwright test e2e/visual.spec.ts",
    "test:visual:update": "E2E_VISUAL=1 playwright test e2e/visual.spec.ts --update-snapshots",
    "test:visual:ci": "E2E_VISUAL=1 playwright test e2e/visual.spec.ts --reporter=github",
    "benchmark:seed": "node scripts/seed-benchmark-data.mjs",
    "analyze": "ANALYZE=true vite build",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@sentry/cloudflare": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "hono": "^4.12.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^7.18.2",
    "reicon-react": "^1.1.302",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  }
}
