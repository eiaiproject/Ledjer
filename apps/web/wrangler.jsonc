{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ledjer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-07",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledjer-production",
      "database_id": "37eff57a-d152-4235-8344-9379c7ad4cf2",
      "preview_database_id": "37eff57a-d152-4235-8344-9379c7ad4cf2",
      "migrations_dir": "worker/db/migrations"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "routes": [
    { "pattern": "ledjer.id", "custom_domain": true },
    { "pattern": "www.ledjer.id", "custom_domain": true }
  ],
  "vars": {
    "APP_ORIGIN": "https://ledjer.id"
  }
}
